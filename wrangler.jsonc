{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "routes": [
    {
      "pattern": "sebastiansiedler.com",
      "custom_domain": true
    },
    {
      "pattern": "www.sebastiansiedler.com",
      "custom_domain": true
    }
  ]
}
